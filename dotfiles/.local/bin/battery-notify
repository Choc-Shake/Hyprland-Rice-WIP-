#!/usr/bin/env bash
# battery-notify: warn once at 15% and once at 5% while discharging.
# Run every 2 min by battery-notify.timer (systemd --user).
BAT=/sys/class/power_supply/BAT0
STATE=${XDG_RUNTIME_DIR:-/tmp}/battery-notify.last
cap=$(<"$BAT/capacity"); status=$(<"$BAT/status")
last=$(cat "$STATE" 2>/dev/null || echo 100)

if [[ $status != Discharging ]]; then rm -f "$STATE"; exit 0; fi

if (( cap <= 5 && last > 5 )); then
    notify-send -u critical -a battery -i battery-caution "Battery critical: ${cap}%" "Plug in now. The laptop will sleep at 2%."
    echo 5 > "$STATE"
elif (( cap <= 15 && last > 15 )); then
    left=$(upower -i /org/freedesktop/UPower/devices/battery_BAT0 | awk -F': *' '/time to empty/{print $2}')
    notify-send -u normal -a battery -i battery-low "Battery low: ${cap}%" "${left:+About $left left. }Plug in soon."
    echo 15 > "$STATE"
fi
