#!/usr/bin/env bash
# cliphist-rofi: clipboard history picker with image thumbnails (SUPER+V)
thumbs=${XDG_CACHE_HOME:-$HOME/.cache}/cliphist/thumbs
mkdir -p "$thumbs"

list=$(cliphist list | tr -d '\0')

sel=$(while IFS=$'\t' read -r id rest; do
    # e.g. "[[ binary data 985 KiB png 1920x1200 ]]" -> "  1920×1200  ·  985 KiB"
    if [[ $rest =~ ^\[\[\ binary\ data\ ([0-9.]+\ [KMG]?i?B)\ (png|jpeg|jpg|bmp|webp|gif)\ ([0-9]+)x([0-9]+) ]]; then
        f="$thumbs/$id.${BASH_REMATCH[2]}"
        [[ -s $f ]] || printf '%s\t\n' "$id" | cliphist decode > "$f"
        printf '%s\t  %s×%s  ·  %s\0icon\x1f%s\n' "$id" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}" "${BASH_REMATCH[1]}" "$f"
    else
        printf '%s\t%s\n' "$id" "$rest"
    fi
done <<< "$list" | rofi -dmenu -i -show-icons -p '📋 Clipboard' -display-columns 2 \
    -theme-str 'listview { lines: 10; spacing: 2px; }
                element { orientation: horizontal; children: [element-icon, element-text]; spacing: 12px; padding: 2px 8px; }
                element-icon { size: 2.2em; vertical-align: 0.5; }
                element-text { vertical-align: 0.5; }') || exit 0

printf '%s\n' "$sel" | cliphist decode | wl-copy

# Drop thumbnails for entries no longer in history
ids=$(cut -f1 <<< "$list")
for f in "$thumbs"/*; do
    [[ -e $f ]] || continue
    grep -qx "$(basename "${f%.*}")" <<< "$ids" || rm -f "$f"
done
